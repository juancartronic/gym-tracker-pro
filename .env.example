# Configuración del Servidor Gym Tracker

# Token de autenticación (cambiar en producción)
AUTH_TOKEN=token-secreto-muy-seguro-123

# Puerto del servidor (para Python)
FLASK_PORT=5000

# Puerto para Node.js
NODE_PORT=3000

# Entorno
FLASK_ENV=development

# Base de datos (futuro)
# DATABASE_URL=postgresql://usuario:contraseña@localhost/gym_tracker
# MONGODB_URL=mongodb+srv://usuario:contraseña@cluster.mongodb.net/gym_tracker

# Configuración CORS (si usas dominio específico)
# ALLOWED_ORIGINS=https://tudominio.com,http://localhost:3000

# Email para notificaciones (opcional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=tu-email@gmail.com
# SMTP_PASSWORD=tu-contraseña-app
